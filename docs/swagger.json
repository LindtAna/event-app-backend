                            "$ref": "#/definitions/main.authResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Registriert einen Owner oder ein eingeladenes Mitglied",
                "parameters": [
                    {
                        "description": "Registrierungsdaten",
                        "name": "user",
